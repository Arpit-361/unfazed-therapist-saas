# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of the React frontend (used for CORS, invite links, Open Graph redirects)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used in share links / Open Graph pages)
API_PUBLIC_URL=http://localhost:5000

# ---------- Database ----------
# MongoDB Atlas / local connection string. Leave empty with DEMO_MODE=true to run an
# in-memory MongoDB (mongodb-memory-server) that is auto-seeded on every start.
MONGO_URI=

# ---------- Demo mode ----------
# true  => missing third-party credentials fall back to simulated providers
#          (in-memory MongoDB, demo payment gateway, logged email/WhatsApp, local storage)
DEMO_MODE=true
# Seed demo data on startup when the database is empty (always on for in-memory DB)
SEED_ON_START=true
# Password used for all seeded demo accounts
DEMO_PASSWORD=Demo@1234

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Razorpay (test mode) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Pricing configuration (all amounts in INR) ----------
CURRENCY=INR
GST_RATE_PERCENT=18
DEFAULT_SESSION_PRICE_INR=1500
PACKAGE_SIZES=3,6,12
SESSION_DURATIONS=30,45,60,90
PAYMENT_HOLD_MINUTES=15
SLOT_STEP_MINUTES=30

# ---------- Email (Nodemailer) ----------
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Unfazed <no-reply@unfazed.in>"

# ---------- WhatsApp ----------
# Only "stub" is implemented (messages are logged/queued) until Business API access exists.
WHATSAPP_PROVIDER=stub

# ---------- File storage ----------
# local => files stored under ./uploads ; s3 => S3 adapter (requires credentials below)
STORAGE_DRIVER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Background jobs ----------
SCHEDULER_INTERVAL_SECONDS=60

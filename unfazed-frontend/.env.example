# Base URL of the Unfazed API (must include /api)
VITE_API_BASE_URL=http://localhost:5000/api
# Optional: Socket.io server URL (defaults to VITE_API_BASE_URL without /api)
VITE_SOCKET_URL=
# Razorpay PUBLIC test key id (never put the key secret in the frontend).
# Optional - the API also returns the key id with each checkout order.
VITE_RAZORPAY_KEY_ID=
